<include src="../../tpl/state.wxml"/>
<view wx:if="{{!loading && !error}}" class="wrap wrap-bar">
  <include src="../../tpl/errors.wxml"/>
  <view class="card">
    <view class="card-title">出了什么问题<text wx:if="{{f.status}}" class="chip {{f.status === '已关闭' ? '' : 'chip-red'}}">{{f.status}}</text></view>
    <view class="field">
      <view class="field-label">哪位学员</view>
      <picker mode="selector" range="{{students}}" range-key="name" value="{{idx.student_id}}" data-k="student_id" data-list="students" bindchange="onPick">
        <view class="picker {{f.student_id ? '' : 'placeholder'}}">{{label.student_id || '不关联学员（比如训练场临时关闭）'}}</view>
      </picker>
    </view>
    <view class="field">
      <view class="field-label">发生日期<text class="req">*</text></view>
      <picker mode="date" value="{{f.occurred_on || today}}" end="{{today}}" data-k="occurred_on" bindchange="onDate"><view class="picker">{{f.occurred_on}}</view></picker>
    </view>
    <view class="field">
      <view class="field-label">发生在哪个环节</view>
      <view class="opts"><view wx:for="{{stages}}" wx:key="*this" class="opt {{f.stage === item ? 'opt-on' : ''}}" bindtap="pickOne" data-k="stage" data-v="{{item}}">{{item}}</view></view>
    </view>
    <view class="field">
      <view class="field-label">类型</view>
      <view class="opts"><view wx:for="{{kinds}}" wx:key="*this" class="opt {{f.kind === item ? 'opt-on' : ''}}" bindtap="pickOne" data-k="kind" data-v="{{item}}">{{item}}</view></view>
    </view>
    <view class="field">
      <view class="field-label">问题描述<text class="req">*</text></view>
      <textarea class="textarea" value="{{f.description}}" data-k="description" bindinput="onField" maxlength="1000" auto-height placeholder="学员原话是什么，实际情况是什么"/>
    </view>
  </view>

  <view class="card">
    <view class="card-title">怎么处理</view>
    <view class="field">
      <view class="field-label">联系了谁<text wx:if="{{!f.solved_on}}" class="req">*</text></view>
      <input class="input" value="{{f.contacted}}" data-k="contacted" bindinput="onField" maxlength="120" placeholder="比如：训练场排班老师、驾校教务"/>
    </view>
    <view class="field">
      <view class="field-label">预计什么时候解决<text wx:if="{{!f.solved_on}}" class="req">*</text></view>
      <picker mode="date" value="{{f.eta_on || today}}" data-k="eta_on" bindchange="onDate">
        <view class="picker {{f.eta_on ? '' : 'placeholder'}}">{{f.eta_on || '给学员一个明确的答复时间'}}</view>
      </picker>
      <view wx:if="{{f.eta_on}}" class="quick"><view class="opt" bindtap="onClear" data-k="eta_on">清除日期</view></view>
    </view>
    <view class="field">
      <view class="field-label">实际解决日期</view>
      <picker mode="date" value="{{f.solved_on || today}}" end="{{today}}" data-k="solved_on" bindchange="onDate">
        <view class="picker {{f.solved_on ? '' : 'placeholder'}}">{{f.solved_on || '还没解决'}}</view>
      </picker>
      <view wx:if="{{f.solved_on}}" class="quick"><view class="opt" bindtap="onClear" data-k="solved_on">清除日期</view></view>
    </view>
    <view class="check" bindtap="onToggle" data-k="revisit_ok">
      <view class="box {{f.revisit_ok ? 'box-on' : ''}}">{{f.revisit_ok ? '✓' : ''}}</view>
      <view class="check-main">已回访确认：学员那边真的没问题了<view class="tiny muted">解决以后还要回访一次，才算关闭。</view></view>
    </view>
    <view wx:if="{{can_all}}" class="field mt">
      <view class="field-label">负责人</view>
      <picker mode="selector" range="{{members}}" range-key="name" value="{{idx.owner_id}}" data-k="owner_id" data-list="members" bindchange="onPick">
        <view class="picker">{{label.owner_id || '未指定'}}</view>
      </picker>
    </view>
    <view class="field mt">
      <view class="field-label">备注</view>
      <textarea class="textarea" value="{{f.remark}}" data-k="remark" bindinput="onField" maxlength="1000" auto-height placeholder="处理过程里值得记下来的"/>
    </view>
  </view>
  <view wx:if="{{can_delete && f.id}}" class="btn btn-danger btn-plain" hover-class="btn-hover" bindtap="remove">删除这条记录</view>
</view>
<view wx:if="{{!loading && !error}}" class="bar">
  <view class="btn btn-primary {{busy ? 'btn-off' : ''}}" hover-class="btn-hover" bindtap="save">保存</view>
</view>
