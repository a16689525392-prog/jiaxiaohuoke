.red { display: flex; align-items: flex-start; padding: 14rpx 0; font-size: 28rpx; }
.red-no { flex: none; width: 44rpx; height: 44rpx; line-height: 44rpx; margin: 2rpx 18rpx 0 0; border-radius: 999rpx; background: #b3261e; color: #fff; text-align: center; font-size: 24rpx; }
.step { display: flex; padding: 22rpx 0; border-top: 1rpx solid #eef1f4; }
.step:first-child { border-top: none; }
.step-when { flex: none; width: 210rpx; }
.step-text { flex: 1; font-size: 26rpx; }
.step-past { opacity: 0.55; }
