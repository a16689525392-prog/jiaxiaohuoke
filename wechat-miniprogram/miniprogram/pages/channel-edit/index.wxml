<include src="../../tpl/state.wxml"/>
<view wx:if="{{!loading && !error}}" class="wrap wrap-bar">
  <include src="../../tpl/errors.wxml"/>
  <view class="card">
    <view class="field">
      <view class="field-label">渠道名称<text class="req">*</text></view>
      <input class="input" value="{{f.name}}" data-k="name" bindinput="onField" maxlength="20" placeholder="比如：宿舍楼海报"/>
    </view>
    <view class="field">
      <view class="field-label">渠道码</view>
      <input class="input" value="{{f.code}}" data-k="code" bindinput="onField" maxlength="8" placeholder="几个字母，加微信时写在备注里，比如 HB"/>
    </view>
    <view class="field">
      <view class="field-label">类型</view>
      <view class="opts"><view wx:for="{{kinds}}" wx:key="*this" class="opt {{f.kind === item ? 'opt-on' : ''}}" bindtap="onChoose" data-k="kind" data-v="{{item}}">{{item}}</view></view>
    </view>
    <view class="field">
      <view class="field-label">状态</view>
      <view class="opts"><view wx:for="{{statuses}}" wx:key="*this" class="opt {{f.status === item ? 'opt-on' : ''}}" bindtap="onChoose" data-k="status" data-v="{{item}}">{{item}}</view></view>
    </view>
    <view class="field">
      <view class="field-label">怎么做</view>
      <textarea class="textarea" value="{{f.how}}" data-k="how" bindinput="onField" maxlength="600" auto-height placeholder="这个渠道具体怎么获客，开口第一句说什么"/>
    </view>
    <view class="field">
      <view class="field-label">备注</view>
      <textarea class="textarea" value="{{f.note}}" data-k="note" bindinput="onField" maxlength="600" auto-height placeholder="负责人、启用时间、要注意的地方"/>
    </view>
  </view>
  <view wx:if="{{f.id}}" class="btn btn-plain {{f.archived ? '' : 'btn-danger'}}" hover-class="btn-hover" bindtap="archive">{{f.archived ? '恢复这个渠道' : '停用这个渠道'}}</view>
</view>
<view wx:if="{{!loading && !error}}" class="bar">
  <view class="btn btn-primary {{busy ? 'btn-off' : ''}}" hover-class="btn-hover" bindtap="save">保存</view>
</view>
